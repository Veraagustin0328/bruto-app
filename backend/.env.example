# Copiá este archivo como .env y completá con tus datos

# Base de datos (la del docker-compose para desarrollo, puerto 5433)
DATABASE_URL=postgresql+psycopg://bruto:bruto@localhost:5433/bruto

# Para firmar los tokens del panel, poné cualquier cosa larga y random
JWT_SECRET=cambiame-por-algo-largo-y-random
JWT_EXPIRA_MINUTOS=720

# Mercado Pago (sacalo de tu cuenta de desarrollador)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URLs para que MP sepa a dónde volver y a dónde avisar
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

# ---- Opcionales: si no los ponés se usan estos valores ----
# Minutos para pagar con MP antes de que se cancele el pedido (y cada cuánto se revisa)
# MINUTOS_PARA_PAGAR=30
# SEGUNDOS_ENTRE_REVISIONES=60

# Límites contra abusos
# LIMITE_PEDIDOS_POR_IP=5
# LIMITE_PEDIDOS_MINUTOS=10
# LIMITE_ACTIVOS_POR_TELEFONO=3
# LOGIN_INTENTOS_MAX=5
# LOGIN_BLOQUEO_MINUTOS=15

# Fotos de productos ("local" = carpeta backend/uploads)
# STORAGE=local
# UPLOADS_DIR=
